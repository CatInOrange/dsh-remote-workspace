diff --git a/apps/desktop/src/native-remote-connector.ts b/apps/desktop/src/native-remote-connector.ts
new file mode 100644
index 0000000..ba650d5
--- /dev/null
+++ b/apps/desktop/src/native-remote-connector.ts
@@ -0,0 +1,130 @@
+/** Desktop-owned authentication. Keep aligned with the external native connector contract. */
+function remoteTarget(address: string, _token: string): { address: string; login: string } {
+  const url = new URL(address)
+  if (url.protocol !== 'https:' || url.username || url.password || url.search || url.hash || (url.pathname !== '/' && url.pathname !== '')) {
+    throw new Error('Remote address must be an HTTPS origin without credentials')
+  }
+  return { address: url.origin, login: url.origin + '/' }
+}
+
+/** Host-only injectable HTTP transport; never run this cookie owner in a browser panel. */
+export type ConnectorFetch = (url: string, init: RequestInit) => Promise<Response>
+
+/** Host socket factory supplies lifecycle ownership without exposing credentials to the UI. */
+export interface ConnectorSocket<T> {
+  readonly socket: T
+  readonly closed: Promise<void>
+  close(): void
+}
+
+/** One authenticated server connection. Credentials remain private and process-local. */
+export class RemoteHostConnector {
+  readonly address: string
+  #cookie: string | undefined
+  #lifetime = new AbortController()
+  #login: AbortController | undefined
+  #disposed = false
+  #authenticationGeneration = 0
+  #sockets = new Set<ConnectorSocket<unknown>>()
+
+  constructor(address: string, private readonly send: ConnectorFetch = globalThis.fetch) {
+    const target = remoteTarget(address, '')
+    if (target.login !== target.address + '/') throw new Error('Supply credentials only to login')
+    this.address = target.address
+  }
+
+  /** Exchange a native launch token without following redirects or retaining the token. */
+  async login(token: string, signal?: AbortSignal): Promise<void> {
+    this.assertLive()
+    if (!token.trim()) throw new Error('A Harness access token is required')
+    this.#login?.abort()
+    const attempt = new AbortController()
+    this.#login = attempt
+    const requestSignal = AbortSignal.any([this.#lifetime.signal, attempt.signal, ...(signal ? [signal] : [])])
+    const url = new URL(this.address)
+    url.searchParams.set('token', token.trim())
+    let response: Response
+    try {
+      response = await this.send(url.href, { method: 'GET', redirect: 'manual', credentials: 'omit', signal: requestSignal })
+    } catch {
+      throw new Error('Remote authentication request failed')
+    }
+    try {
+      requestSignal.throwIfAborted()
+      if (response.status !== 303 || new URL(response.headers.get('location') ?? '', this.address).href !== this.address + '/') {
+        throw new Error('Remote authentication was refused')
+      }
+      const cookies = response.headers.getSetCookie()
+        .map(value => value.split(';', 1)[0]!)
+        .filter(value => /^dsh-auth-[A-Za-z0-9_-]+=[A-Za-z0-9_.-]+$/.test(value))
+      if (cookies.length !== 1) throw new Error('Remote authentication did not issue a supported cookie')
+      this.#cookie = cookies[0]
+      ++this.#authenticationGeneration
+    } finally {
+      await response.body?.cancel()
+      if (this.#login === attempt) this.#login = undefined
+    }
+  }
+
+  /** Send only native API requests to this server; redirects cannot forward its cookie elsewhere. */
+  async fetch(path: string, init: RequestInit = {}): Promise<Response> {
+    this.assertLive()
+    if (!this.#cookie) throw new Error('Remote connection is not authenticated')
+    // Match Connection's generated channel/endpoint routes, not arbitrary user URLs.
+    if (!/^\/?api\/[A-Za-z0-9_$-]+(?:\.[A-Za-z0-9_$-]+)*(?:\/[A-Za-z0-9_$.-]+)*$/.test(path)
+      || path.split('/').some(part => part === '.' || part === '..')) throw new Error('Unsupported remote API route')
+    const url = new URL(path.replace(/^\//, ''), this.address + '/')
+    const headers = new Headers(init.headers)
+    headers.delete('authorization')
+    headers.set('cookie', this.#cookie)
+    const signal = AbortSignal.any([this.#lifetime.signal, ...(init.signal ? [init.signal] : [])])
+    const generation = this.#authenticationGeneration
+    let response: Response
+    try {
+      response = await this.send(url.href, { ...init, headers, credentials: 'omit', redirect: 'manual', signal })
+    } catch {
+      throw new Error('Remote API transport failed')
+    }
+    if (signal.aborted) {
+      await response.body?.cancel()
+      throw new Error('Remote API request was cancelled')
+    }
+    if (response.status === 401 && generation === this.#authenticationGeneration) this.#cookie = undefined
+    if (response.status >= 300 && response.status < 400) {
+      await response.body?.cancel()
+      throw new Error('Remote API redirects are not supported')
+    }
+    return response
+  }
+
+  /** Open the native multiplexed stream socket using this Host's cookie and exact API path. */
+  openWebSocket<T>(path: string, create: (url: string, cookie: string) => ConnectorSocket<T>): T {
+    this.assertLive()
+    if (!this.#cookie) throw new Error('Remote connection is not authenticated')
+    if (path !== '/api/remote.mux') throw new Error('Unsupported remote socket route')
+    const url = new URL(path, this.address)
+    url.protocol = 'wss:'
+    const owned = create(url.href, this.#cookie)
+    this.#sockets.add(owned)
+    const release = (): void => { this.#sockets.delete(owned) }
+    void owned.closed.then(release, release)
+    return owned.socket
+  }
+
+  /** Forget credentials and cancel owned requests; does not stop server-side tasks. */
+  dispose(): void {
+    if (this.#disposed) return
+    this.#disposed = true
+    this.#cookie = undefined
+    ++this.#authenticationGeneration
+    this.#lifetime.abort()
+    for (const socket of this.#sockets) {
+      try { socket.close() } catch { /* Continue releasing independently owned sockets. */ }
+    }
+    this.#sockets.clear()
+  }
+
+  private assertLive(): void {
+    if (this.#disposed) throw new Error('Remote connector is disposed')
+  }
+}
diff --git a/apps/desktop/src/native-remote-protocol.ts b/apps/desktop/src/native-remote-protocol.ts
new file mode 100644
index 0000000..7d597c1
--- /dev/null
+++ b/apps/desktop/src/native-remote-protocol.ts
@@ -0,0 +1,25 @@
+/** Narrow, credential-free renderer carrier for a main-owned remote connection. */
+export interface NativeRemoteRequest {
+  readonly id: string
+  readonly path: string
+  readonly method: 'GET' | 'POST'
+  readonly body?: Uint8Array
+  readonly contentType?: string
+}
+export interface NativeRemoteResponse {
+  readonly status: number
+  readonly contentType: string | null
+  readonly body: Uint8Array
+}
+export type NativeRemoteEvent = { readonly id: string; readonly type: 'open' | 'close' | 'error' }
+  | { readonly id: string; readonly type: 'message'; readonly data: string }
+export interface NativeRemoteBridge {
+  connect(address: string, token: string): Promise<{ readonly lease: string; readonly address: string }>
+  release(lease: string): Promise<void>
+  request(lease: string, request: NativeRemoteRequest): Promise<NativeRemoteResponse>
+  cancel(lease: string, id: string): Promise<void>
+  open(lease: string, id: string): Promise<void>
+  send(lease: string, id: string, data: string): Promise<void>
+  close(lease: string, id: string): Promise<void>
+  subscribe(listener: (event: NativeRemoteEvent) => void): () => void
+}
diff --git a/apps/desktop/src/native-remote.ts b/apps/desktop/src/native-remote.ts
new file mode 100644
index 0000000..78bfcea
--- /dev/null
+++ b/apps/desktop/src/native-remote.ts
@@ -0,0 +1,125 @@
+/** Main-process remote leases: never exposes authentication cookies to a renderer. */
+import { randomUUID } from 'node:crypto'
+import WebSocket from 'ws'
+import { RemoteHostConnector } from './native-remote-connector.ts'
+import type { NativeRemoteEvent, NativeRemoteRequest, NativeRemoteResponse } from './native-remote-protocol.ts'
+
+interface Lease {
+  readonly owner: number
+  readonly connector: RemoteHostConnector
+  readonly requests: Map<string, AbortController>
+  readonly sockets: Map<string, WebSocket>
+}
+
+export class DesktopNativeRemotes {
+  private readonly leases = new Map<string, Lease>()
+  private readonly pending = new Map<number, RemoteHostConnector>()
+  constructor(private readonly emit: (owner: number, event: NativeRemoteEvent) => void) {}
+
+  async connect(owner: number, address: unknown, token: unknown): Promise<{ lease: string; address: string }> {
+    if (typeof address !== 'string' || typeof token !== 'string') throw new Error('Invalid remote credentials')
+    if (this.pending.has(owner) || [...this.leases.values()].some(lease => lease.owner === owner)) throw new Error('Release the existing remote connection first')
+    const connector = new RemoteHostConnector(address)
+    this.pending.set(owner, connector)
+    try {
+      await connector.login(token)
+      if (this.pending.get(owner) !== connector) throw new Error('Remote connection cancelled')
+      const lease = randomUUID()
+      this.leases.set(lease, { owner, connector, requests: new Map(), sockets: new Map() })
+      return { lease, address: connector.address }
+    } catch (error) { connector.dispose(); throw error }
+    finally { if (this.pending.get(owner) === connector) this.pending.delete(owner) }
+  }
+
+  release(owner: number, id: unknown): void {
+    const lease = this.owned(owner, id)
+    this.leases.delete(id as string)
+    for (const request of lease.requests.values()) request.abort()
+    lease.connector.dispose()
+  }
+
+  disposeOwner(owner: number): void {
+    this.pending.get(owner)?.dispose()
+    this.pending.delete(owner)
+    for (const [id, lease] of this.leases) if (lease.owner === owner) this.release(owner, id)
+  }
+
+  async request(owner: number, id: unknown, input: NativeRemoteRequest): Promise<NativeRemoteResponse> {
+    const lease = this.owned(owner, id)
+    if (input === null || typeof input !== 'object' || typeof input.path !== 'string'
+      || (input.method !== 'GET' && input.method !== 'POST')
+      || (input.body !== undefined && (!(input.body instanceof Uint8Array) || input.body.byteLength > 32 * 1024 * 1024))
+      || (input.contentType !== undefined && input.contentType !== 'application/json')) throw new Error('Invalid remote request')
+    this.validId(input.id)
+    if (lease.requests.has(input.id) || lease.requests.size >= 32) throw new Error('Remote request limit reached')
+    const abort = new AbortController()
+    lease.requests.set(input.id, abort)
+    try {
+      const response = await lease.connector.fetch(input.path, { method: input.method, signal: abort.signal,
+        ...(input.body === undefined ? {} : { body: input.body as BodyInit }),
+        ...(input.contentType === undefined ? {} : { headers: { 'content-type': input.contentType } }),
+      })
+      const reader = response.body?.getReader()
+      const chunks: Uint8Array[] = []
+      let length = 0
+      try {
+        if (reader !== undefined) for (;;) {
+          const next = await reader.read()
+          if (next.done) break
+          length += next.value.byteLength
+          if (length > 32 * 1024 * 1024) throw new Error('Remote response exceeds carrier limit')
+          chunks.push(next.value)
+        }
+      } finally { await reader?.cancel() }
+      const body = new Uint8Array(length)
+      let offset = 0
+      for (const chunk of chunks) { body.set(chunk, offset); offset += chunk.byteLength }
+      return { status: response.status, contentType: response.headers.get('content-type'), body }
+    } finally { lease.requests.delete(input.id) }
+  }
+
+  cancel(owner: number, leaseId: unknown, id: unknown): void {
+    this.validId(id)
+    this.owned(owner, leaseId).requests.get(id)?.abort()
+  }
+
+  open(owner: number, leaseId: unknown, id: unknown): void {
+    const lease = this.owned(owner, leaseId)
+    this.validId(id)
+    if (lease.sockets.has(id) || lease.sockets.size >= 4) throw new Error('Remote socket limit reached')
+    const socket = lease.connector.openWebSocket('/api/remote.mux', (url, cookie) => {
+      const socket = new WebSocket(url, { headers: { cookie }, followRedirects: false, maxPayload: 32 * 1024 * 1024 })
+      return { socket, closed: new Promise<void>(resolve => socket.once('close', () => resolve())), close: () => socket.close() }
+    })
+    lease.sockets.set(id, socket)
+    const emit = (event: NativeRemoteEvent): void => { if (this.leases.get(leaseId as string) === lease) this.emit(owner, event) }
+    socket.on('open', () => emit({ id, type: 'open' }))
+    socket.on('message', (data, binary) => {
+      if (binary) { socket.close(1003); return }
+      emit({ id, type: 'message', data: data.toString() })
+    })
+    socket.on('error', () => emit({ id, type: 'error' }))
+    socket.on('close', () => { lease.sockets.delete(id); emit({ id, type: 'close' }) })
+  }
+
+  send(owner: number, leaseId: unknown, id: unknown, data: unknown): void {
+    this.validId(id)
+    const socket = this.owned(owner, leaseId).sockets.get(id)
+    if (typeof data !== 'string' || Buffer.byteLength(data) > 32 * 1024 * 1024 || socket?.readyState !== WebSocket.OPEN) throw new Error('Remote socket is not writable')
+    socket.send(data)
+  }
+
+  close(owner: number, leaseId: unknown, id: unknown): void {
+    this.validId(id)
+    this.owned(owner, leaseId).sockets.get(id)?.close()
+  }
+
+  private owned(owner: number, id: unknown): Lease {
+    const lease = typeof id === 'string' ? this.leases.get(id) : undefined
+    if (lease === undefined || lease.owner !== owner) throw new Error('Remote connection lease is unavailable')
+    return lease
+  }
+  private validId(id: unknown): asserts id is string {
+    if (typeof id !== 'string' || !/^[a-zA-Z0-9-]{1,80}$/.test(id)) throw new Error('Invalid remote carrier id')
+  }
+}
