+import { Context } from '@deepseek-ai/cordis'
+import { createSnapshotStore } from '@deepseek-ai/dsh-client-store'
+import { ResourceAccessSources } from '../src/client/sources.ts'
+import { expect, it, vi } from 'vitest'
+it('switches an existing access source to remote grants and denies it after withdrawal without local fallback', async () => {
+  const ctx = new Context()
+  const local = createSnapshotStore(true), remote = createSnapshotStore(false)
+  const sources = new ResourceAccessSources(() => local)
+  const outward = sources.source('session', 'mapped', 'session/prompt')
+  const listener = vi.fn()
+  const unsubscribe = outward.subscribe(listener)
+  try {
+    expect(outward.getSnapshot()).toBe(true)
+    const withdraw = sources.register(ctx, { key: 'remote', owns: (_kind, id) => id === 'mapped', source: () => remote })
+    expect(outward.getSnapshot()).toBe(false)
+    remote.set(true); expect(outward.getSnapshot()).toBe(true)
+    expect(listener).toHaveBeenCalledTimes(2)
+    withdraw(); expect(outward.getSnapshot()).toBe(false)
+    expect(sources.source('session', 'local', 'session/prompt').getSnapshot()).toBe(true)
+    expect(sources.source('session', 'mapped', 'session/prompt')).toBe(outward)
+    const count = listener.mock.calls.length
+    remote.set(false); local.set(false)
+    expect(listener).toHaveBeenCalledTimes(count)
+  } finally { unsubscribe(); await ctx.fiber.dispose() }
+})
