+++ b/packages/api/session-controller/src/client/sessions/sources.ts
@@ -0,0 +1,213 @@
+/** Source-aware Session facade; adapters retain ownership of their remote contexts and IDs. */
+import type { Context } from '@deepseek-ai/cordis'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+import type { WorkspaceId } from '@deepseek-ai/dsh-workspace/types'
+import { createSnapshotStore } from '@deepseek-ai/dsh-client-store'
+import type { ISessions, SessionReference, SessionRetainOptions, SessionTarget } from '../contract/sessions.ts'
+import type { SessionListState } from './service.ts'
+
+/** Independent controller whose catalogs and arguments already use Client-visible identities. */
+export interface SessionSource {
+  readonly key: string
+  /** Must be stable and reserve the whole source identity family, including unlisted children. */
+  ownsSession(id: SessionId): boolean
+  /** Must reserve workspace identities even while the catalog is empty or offline. */
+  ownsWorkspace(id: WorkspaceId): boolean
+  readonly sessions: ISessions
+}
+
+interface Entry { readonly source: SessionSource; active: boolean; unsubscribe: () => void; readonly references: Set<SessionReference> }
+
+/** Composes catalogs without constructing remote bindings through the local SessionManager. */
+export class SourceSessions implements ISessions {
+  readonly list = createSnapshotStore<SessionListState>({ ids: [], byId: {}, phase: 'pending', projectionsBySession: {} })
+  private readonly entries: Entry[] = []
+  private closed = false
+  readonly searchResultLimit: number
+
+  /**
+   * @param ctx - owner of the facade and its subscriptions.
+   * @param local - unchanged local Session Controller.
+   */
+  constructor(ctx: Context, private readonly local: ISessions) {
+    this.searchResultLimit = local.searchResultLimit
+    const unsubscribe = local.list.subscribe(() => this.publish())
+    ctx.effect(() => () => {
+      this.closed = true
+      unsubscribe()
+      for (const entry of this.entries) { entry.active = false; entry.unsubscribe(); for (const ref of [...entry.references]) ref.release() }
+    }, 'session-controller.sources')
+    this.publish()
+  }
+
+  /**
+   * Register a mapped source. Withdrawal removes rows and releases facade-owned references, not Host work.
+   * Ownership predicates remain reserved after withdrawal; source keys cannot be reused in this facade.
+   * @param ctx - contribution lifetime.
+   * @param source - mapped controller and stable ownership predicates.
+   * @returns idempotent withdrawal function.
+   */
+  registerSource(ctx: Context, source: SessionSource): () => void {
+    if (this.closed) throw new Error('Session sources disposed')
+    if (!source.key || this.entries.some(entry => entry.source.key === source.key)) throw new Error('Session source key already reserved')
+    if (source.sessions === this || source.sessions === this.local) throw new Error('Session source must have an independent controller')
+    const entry: Entry = { source, active: true, unsubscribe: () => {}, references: new Set() }
+    this.entries.push(entry)
+    const withdraw = (): void => {
+      if (!entry.active) return
+      entry.active = false
+      entry.unsubscribe()
+      for (const ref of [...entry.references]) ref.release()
+      this.publish()
+    }
+    try {
+      this.publish()
+      entry.unsubscribe = source.sessions.list.subscribe(() => {
+        try { this.publish() } catch (error) { withdraw(); throw error }
+      })
+      ctx.effect(() => withdraw, `session-controller.source.${source.key}`)
+      return withdraw
+    } catch (error) {
+      entry.active = false
+      entry.unsubscribe()
+      this.entries.splice(this.entries.indexOf(entry), 1)
+      this.publish()
+      throw error
+    }
+  }
+
+  retain(target: SessionTarget, options: SessionRetainOptions): SessionReference {
+    const owner = typeof target === 'string' ? this.forSession(target as SessionId) : this.commonOwner(target.parentSessionId, target.childSessionId)
+    const reference = owner.retain(target, options)
+    const entry = this.entries.find(candidate => candidate.active && candidate.source.sessions === owner)
+    if (entry === undefined) return reference
+    let released = false
+    const release = (): void => {
+      if (released) return
+      released = true
+      entry.references.delete(wrapped)
+      reference.release()
+    }
+    const wrapped: SessionReference = {
+      sessionId: reference.sessionId,
+      get binding() {
+        if (released || !entry.active) throw new Error('Session source reference released')
+        return reference.binding
+      },
+      ready: reference.ready.then(binding => {
+        if (released || !entry.active) throw new Error('Session source reference released')
+        return binding
+      }),
+      release,
+      [Symbol.dispose]: release,
+    }
+    void wrapped.ready.catch(() => {})
+    entry.references.add(wrapped)
+    return wrapped
+  }
+
+  async using<T>(target: SessionTarget, options: SessionRetainOptions, operation: (reference: SessionReference) => T | Promise<T>): Promise<T> {
+    const reference = this.retain(target, options)
+    try { await reference.ready; return await operation(reference) } finally { reference.release() }
+  }
+
+  retainInfo(id: SessionId): ReturnType<ISessions['retainInfo']> { return this.forSession(id).retainInfo(id) }
+  subagentAddress(id: SessionId): ReturnType<ISessions['subagentAddress']> { return this.forSession(id).subagentAddress(id) }
+  refreshProjections(id: SessionId): Promise<void> { return this.forSession(id).refreshProjections(id) }
+
+  async refresh(): Promise<void> {
+    this.assertOpen()
+    await Promise.all([this.local, ...this.entries.filter(entry => entry.active).map(entry => entry.source.sessions)].map(controller => controller.refresh()))
+  }
+
+  /** Search remains local; remote search requires an explicit source selection in the consumer. */
+  search(...args: Parameters<ISessions['search']>): ReturnType<ISessions['search']> {
+    this.assertOpen()
+    return this.local.search(...args)
+  }
+
+  create(opts: Parameters<ISessions['create']>[0] = {}): ReturnType<ISessions['create']> {
+    this.assertOpen()
+    const workspaceOwner = opts.workspaceId === undefined ? undefined : this.forWorkspace(opts.workspaceId)
+    const sessionOwner = opts.sessionId === undefined ? undefined : this.forSession(opts.sessionId)
+    if (workspaceOwner && sessionOwner && workspaceOwner !== sessionOwner) throw new Error('Cross-source Session creation refused')
+    return (workspaceOwner ?? sessionOwner ?? this.local).create(opts)
+  }
+
+  fork(opts: Parameters<ISessions['fork']>[0]): ReturnType<ISessions['fork']> { return this.forSession(opts.sessionId).fork(opts) }
+  scope(id: SessionId): ReturnType<ISessions['scope']> { return this.forSession(id).scope(id) }
+  binding(id: SessionId): ReturnType<ISessions['binding']> { return this.forSession(id).binding(id) }
+
+  scopeOf(ctx: Context): ReturnType<ISessions['scopeOf']> {
+    this.assertOpen()
+    for (const entry of this.entries) {
+      if (!entry.active) continue
+      if (entry.source.sessions.sessionOf(ctx) === undefined) continue
+      const id = entry.source.sessions.scopeOf(ctx)
+      if (id !== undefined) {
+        if (this.forSession(id) !== entry.source.sessions) throw new Error('Session scope belongs to another source')
+        return id
+      }
+    }
+    if (this.local.sessionOf(ctx) === undefined) return undefined
+    const id = this.local.scopeOf(ctx)
+    if (id !== undefined && this.forSession(id) !== this.local) throw new Error('Foreign Session scope')
+    return id
+  }
+
+  sessionOf(ctx: Context): ReturnType<ISessions['sessionOf']> {
+    const id = this.scopeOf(ctx)
+    return id === undefined ? undefined : this.forSession(id).sessionOf(ctx)
+  }
+
+  private assertOpen(): void { if (this.closed) throw new Error('Session sources disposed') }
+
+  private forSession(id: SessionId): ISessions { return this.owner('session', id) }
+  private forWorkspace(id: WorkspaceId): ISessions { return this.owner('workspace', id) }
+
+  private owner(kind: 'session' | 'workspace', id: SessionId | WorkspaceId): ISessions {
+    this.assertOpen()
+    const owners = this.entries.filter(entry => kind === 'session'
+      ? entry.source.ownsSession(id as SessionId) : entry.source.ownsWorkspace(id as WorkspaceId))
+    if (owners.length > 1) throw new Error('Ambiguous Session source identity')
+    const entry = owners[0]
+    if (entry === undefined) return this.local
+    if (!entry.active) throw new Error('Session source unavailable')
+    return entry.source.sessions
+  }
+
+  private commonOwner(parent: SessionId, child: SessionId): ISessions {
+    const owner = this.forSession(parent)
+    if (owner !== this.forSession(child)) throw new Error('Cross-source subagent address refused')
+    return owner
+  }
+
+  private publish(): void {
+    if (this.closed) return
+    const local = this.local.list.getSnapshot()
+    const next: SessionListState = { ids: [...local.ids], byId: { ...local.byId }, phase: local.phase, projectionsBySession: { ...local.projectionsBySession } }
+    const projections = { ...next.projectionsBySession }
+    for (const id of Object.keys(local.byId)) {
+      if (this.forSession(id as SessionId) !== this.local) throw new Error('Local Session uses a reserved source identity')
+    }
+    for (const entry of this.entries) {
+      if (!entry.active) continue
+      const snapshot = entry.source.sessions.list.getSnapshot()
+      for (const [key, row] of Object.entries(snapshot.byId)) {
+        const id = key as SessionId
+        if (row.id !== id || this.forSession(id) !== entry.source.sessions || next.byId[id] !== undefined) throw new Error('Invalid mapped Session catalog identity')
+        next.byId[id] = row
+      }
+      for (const id of snapshot.ids) {
+        if (snapshot.byId[id] === undefined) throw new Error('Mapped Session list has no summary')
+        next.ids.push(id)
+      }
+      for (const [key, projection] of Object.entries(snapshot.projectionsBySession)) {
+        const id = key as SessionId
+        if (this.forSession(id) !== entry.source.sessions) throw new Error('Foreign Session projection identity')
+        projections[id] = projection
+      }
+    }
+    this.list.set({ ...next, projectionsBySession: projections })
+  }
+}
