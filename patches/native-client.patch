@@ -0,0 +1,98 @@
+/** Source catalogs, isolated acquisition, and withdrawal routing. */
+import { Context } from '@deepseek-ai/cordis'
+import { describe, expect, it, vi } from 'vitest'
+import { createSnapshotStore } from '@deepseek-ai/dsh-client-store'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+import type { WorkspaceId } from '@deepseek-ai/dsh-workspace/types'
+import type { ISessions, SessionReference } from '../src/client/contract/sessions.ts'
+import type { SessionBinding, SessionListState } from '../src/client/sessions/service.ts'
+import { SourceSessions, type SessionSource } from '../src/client/sessions/sources.ts'
+const sid = (value: string): SessionId => value as SessionId
+const wid = (value: string): WorkspaceId => value as WorkspaceId
+function backend(id: string) {
+  const key = sid(id)
+  const list = createSnapshotStore<SessionListState>({ ids: [key], byId: {
+    [key]: { id: key, displayTitle: id, running: false, retainedBy: {}, blank: false, updatedAt: 0 },
+  }, phase: 'ready', projectionsBySession: {} })
+  const binding = { ctx: new Context() } as SessionBinding
+  const release = vi.fn()
+  const reference: SessionReference = { sessionId: key, binding, ready: Promise.resolve(binding), release, [Symbol.dispose]: release }
+  const controller: ISessions = {
+    list, searchResultLimit: 30,
+    retain: vi.fn(() => reference), using: vi.fn(),
+    retainInfo: vi.fn(() => createSnapshotStore({ referenceCount: 0, retainedBy: {} })),
+    create: vi.fn(async () => key), subagentAddress: vi.fn(), refreshProjections: vi.fn(async () => {}),
+    refresh: vi.fn(async () => {}), search: vi.fn(async () => ({ ok: true as const, value: { items: [], hasMore: false } })),
+    fork: vi.fn(async () => key), scope: vi.fn(() => binding.ctx), scopeOf: vi.fn(), sessionOf: vi.fn(), binding: vi.fn(() => binding),
+  }
+  const source: SessionSource = { key: id, ownsSession: value => value.startsWith('remote:'), ownsWorkspace: value => value.startsWith('remote:'), sessions: controller }
+  return { controller, source, list, binding, release }
+}
+describe('Session source routing', () => {
+  it('composes catalogs and preserves the remote binding context while commands route by identity', async () => {
+    const root = new Context(), owner = new Context()
+    const local = backend('local'), remote = backend('remote:s')
+    const facade = new SourceSessions(root, local.controller)
+    try {
+      facade.registerSource(owner, remote.source)
+      expect(facade.list.getSnapshot().ids).toEqual(['local', 'remote:s'])
+      const reference = facade.retain(sid('remote:s'), { source: 'gateway' })
+      expect((await reference.ready).ctx).toBe(remote.binding.ctx)
+      expect(reference.binding).toBe(remote.binding)
+      expect(local.controller.retain).not.toHaveBeenCalled()
+      await facade.create({ workspaceId: wid('remote:w') })
+      expect(remote.controller.create).toHaveBeenCalledWith({ workspaceId: 'remote:w' })
+      facade.binding(sid('remote:s'))
+      facade.refreshProjections(sid('remote:s'))
+      await facade.fork({ sessionId: sid('remote:s') })
+      expect(remote.controller.binding).toHaveBeenCalled()
+      expect(remote.controller.refreshProjections).toHaveBeenCalled()
+      expect(remote.controller.fork).toHaveBeenCalled()
+      await owner.fiber.dispose()
+      expect(remote.release).toHaveBeenCalledOnce()
+      expect(() => reference.binding).toThrow('released')
+      expect(facade.list.getSnapshot().ids).toEqual(['local'])
+      expect(() => facade.retain(sid('remote:unlisted'), { source: 'gateway' })).toThrow('unavailable')
+      expect(() => facade.create({ workspaceId: wid('remote:w') })).toThrow('unavailable')
+      expect(local.controller.create).not.toHaveBeenCalled()
+    } finally { await Promise.all([root.fiber.dispose(), owner.fiber.dispose()]) }
+  })
+  it('refuses cross-source addresses and create reuse, and invalid catalog identities', async () => {
+    const root = new Context(), owner = new Context()
+    const local = backend('local'), remote = backend('remote:s')
+    const facade = new SourceSessions(root, local.controller)
+    try {
+      facade.registerSource(owner, remote.source)
+      expect(() => facade.retain({ parentSessionId: sid('local'), childSessionId: sid('remote:s'), mode: 'unknown' }, { source: 'gateway' })).toThrow('Cross-source')
+      expect(() => facade.create({ workspaceId: wid('remote:w'), sessionId: sid('local') })).toThrow('Cross-source')
+      expect(() => facade.registerSource(owner, remote.source)).toThrow('reserved')
+      const invalid = backend('foreign')
+      expect(() => facade.registerSource(owner, { ...invalid.source, key: 'invalid', ownsSession: value => value.startsWith('different:') })).toThrow('Invalid mapped')
+      expect(facade.list.getSnapshot().ids).toEqual(['local', 'remote:s'])
+      const conflict = backend('remote:s')
+      expect(() => facade.registerSource(owner, { ...conflict.source, key: 'overlap' })).toThrow('Ambiguous')
+      expect(facade.binding(sid('remote:s'))).toBe(remote.binding)
+      expect(() => facade.registerSource(owner, { ...conflict.source, key: 'local-collision', ownsSession: () => true })).toThrow('Local Session')
+      expect(facade.binding(sid('local'))).toBe(local.binding)
+    } finally { await Promise.all([root.fiber.dispose(), owner.fiber.dispose()]) }
+  })
+})
+
+it('never resolves a foreign or retired source scope through an identical local tag', async () => {
+  const root = new Context(), owner = new Context()
+  const local = backend('same'), remote = backend('remote:s')
+  const foreign = remote.binding.ctx
+  vi.mocked(local.controller.scopeOf).mockReturnValue(sid('same'))
+  vi.mocked(local.controller.sessionOf).mockImplementation(ctx => ctx === local.binding.ctx ? {} as never : undefined)
+  vi.mocked(remote.controller.scopeOf).mockReturnValue(sid('remote:s'))
+  vi.mocked(remote.controller.sessionOf).mockImplementation(ctx => ctx === foreign ? {} as never : undefined)
+  const facade = new SourceSessions(root, local.controller)
+  try {
+    expect(facade.scopeOf(foreign)).toBeUndefined()
+    facade.registerSource(owner, remote.source)
+    expect(facade.scopeOf(foreign)).toBe('remote:s')
+    await owner.fiber.dispose()
+    expect(facade.scopeOf(foreign)).toBeUndefined()
+    expect(facade.scopeOf(local.binding.ctx)).toBe('same')
+  } finally { await owner.fiber.dispose(); await root.fiber.dispose() }
+})
