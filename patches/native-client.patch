@@ -0,0 +1,233 @@
+/** Independent native Client runtimes never borrow the page's local Connection. */
+import { Context } from '@deepseek-ai/cordis'
+import { installConnection, type ConnectionHandle } from '@deepseek-ai/dsh-client-connection/client'
+import TypertRegistry from '@deepseek-ai/dsh-typert-registry'
+import type { RemoteResult, RemoteStreamHandle, TypertRemoteNamespace } from '@deepseek-ai/dsh-typert-protocol'
+import { describe, expect, it, vi } from 'vitest'
+import { z } from 'zod'
+import { createClientRemoteRuntime, type ClientRemoteRuntime } from '../src/client/index.ts'
+
+declare module '@deepseek-ai/dsh-typert-protocol' {
+  interface TypertRemoteMap {
+    'runtimeProbe/read': () => Promise<RemoteResult<string>>
+    'runtimeProbe/watch': () => RemoteStreamHandle<string, never>
+  }
+  interface TypertRemoteNamespaceMap {
+    runtimeProbe: TypertRemoteNamespace<'runtimeProbe'>
+  }
+  interface TypertRemoteEventSelection extends Record<'runtime-probe/changed', true> {}
+}
+
+declare module '@deepseek-ai/cordis' {
+  interface Events {
+    /** @param value - remote runtime marker. @mode emit */
+    'runtime-probe/changed'(value: string): void
+  }
+}
+
+async function fixture(name: string) {
+  const ctx = new Context()
+  const carrier = new Context()
+  const publish = Promise.withResolvers<void>()
+  const calls: string[] = []
+  const streams: string[] = []
+  const closed: string[] = []
+  const carrierState = { offline: false }
+  const ambient = vi.fn<ConnectionHandle['rpc']['call']>()
+  installConnection(ctx, {
+    interactions: 'none',
+    transport: { rpc: { call: ambient, open: async function* () { throw new Error('ambient stream used') } } },
+  })
+  installConnection(carrier, {
+    interactions: 'answer',
+    transport: {
+      rpc: {
+        call: async (_channel, endpoint) => {
+          calls.push(endpoint)
+          if (carrierState.offline) throw new Error('remote carrier offline')
+          return { ok: true, value: name }
+        },
+        open: async function* (_channel, endpoint, _payload, signal) {
+          streams.push(endpoint)
+          const stopped = new Promise<void>(resolve => {
+            if (signal.aborted) resolve()
+            else signal.addEventListener('abort', () => { resolve() }, { once: true })
+          })
+          try {
+            if (endpoint === '$events') {
+              yield { type: 'ready', clientId: name, host: { home: `/hosts/${name}` } }
+              await Promise.race([publish.promise, stopped])
+              if (signal.aborted) return
+              yield { type: 'emit', event: 'runtime-probe/changed', args: [name] }
+            } else {
+              yield name
+            }
+            await stopped
+          } finally {
+            closed.push(endpoint)
+          }
+        },
+      },
+    },
+  })
+  let runtime: ClientRemoteRuntime | undefined
+  const dispose = async () => {
+    publish.resolve()
+    await runtime?.dispose()
+    await ctx.fiber.dispose()
+    await carrier.fiber.dispose()
+  }
+  try {
+    await ctx.plugin(TypertRegistry)
+    runtime = await createClientRemoteRuntime(ctx, carrier.get('connection') as ConnectionHandle)
+    await runtime.remote.$mount({
+      package: '@fixture/runtime',
+      descriptors: ['read', 'watch'].map(method => ({
+        id: `@fixture/runtime#runtimeProbe/${method}`, service: 'runtimeProbe', namespace: 'runtimeProbe', method,
+        invocation: { kind: 'direct' }, parameters: [], ...(method === 'watch' ? { mode: 'stream' as const } : {}),
+        result: { mode: 'strict', typeSymbol: '@fixture#String', create: () => z.string() },
+      })),
+    })
+    return { ctx, runtime, calls, streams, closed, ambient, publish, carrierState, dispose }
+  } catch (error) {
+    await dispose()
+    throw error
+  }
+}
+
+describe('independent native Remote runtime', () => {
+  it('withdraws a partially started runtime when its Connection refuses startup', async () => {
+    const ctx = new Context()
+    const unregister = vi.fn()
+    const connection: ConnectionHandle = {
+      interactions: 'answer', isLoopback: false,
+      generation: { getSnapshot: () => undefined, subscribe: () => () => {} },
+      state: { getSnapshot: () => undefined, subscribe: () => () => {} },
+      rpc: { call: vi.fn(), open: async function* () {} },
+      openWebSocket: () => { throw new Error('unexpected socket') },
+      reconnect: () => {},
+      registerGenerationSource: () => unregister,
+      start: () => { throw new Error('Connection already running') },
+    }
+    try {
+      await ctx.plugin(TypertRegistry)
+      await expect(createClientRemoteRuntime(ctx, connection)).rejects.toThrow('Connection already running')
+      expect(ctx.get('remote')).toBeUndefined()
+      expect(unregister).toHaveBeenCalledExactlyOnceWith()
+    } finally {
+      await ctx.fiber.dispose()
+    }
+  })
+
+  it('reports an offline explicit carrier without trying the ambient local carrier', async () => {
+    const remote = await fixture('linux')
+    try {
+      remote.carrierState.offline = true
+      await expect(remote.runtime.remote.runtimeProbe.read()).resolves.toMatchObject({
+        ok: false, error: { code: 'gateway/internal', message: expect.stringContaining('remote carrier offline') },
+      })
+      expect(remote.ambient).not.toHaveBeenCalled()
+      remote.carrierState.offline = false
+      await expect(remote.runtime.remote.runtimeProbe.read()).resolves.toEqual({ ok: true, value: 'linux' })
+    } finally {
+      await remote.dispose()
+    }
+  })
+
+  it('pins unary, stream, Host facts and forwarded events to each explicit carrier', async () => {
+    const local = await fixture('local')
+    const remote = await fixture('linux')
+    try {
+      const localEvent = vi.fn()
+      const remoteEvent = vi.fn()
+      local.runtime.remote.$on('runtime-probe/changed', localEvent)
+      remote.runtime.remote.$on('runtime-probe/changed', remoteEvent)
+      local.publish.resolve()
+      remote.publish.resolve()
+      await expect(local.runtime.remote.runtimeProbe.read()).resolves.toEqual({ ok: true, value: 'local' })
+      await expect(remote.runtime.remote.runtimeProbe.read()).resolves.toEqual({ ok: true, value: 'linux' })
