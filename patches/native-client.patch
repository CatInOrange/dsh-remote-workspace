+  ipcMain.handle('dsh-desktop:native-remote-open', (event, lease, id) => {
+    assert.equal(lease, 'fixture')
+    event.sender.send('dsh-desktop:native-remote-event', { id, type: 'open' })
+  })
+  ipcMain.handle('dsh-desktop:native-remote-release', () => {})
+  const window = new BrowserWindow({ show: false, webPreferences: {
+    preload: resolve(__dirname, '../../lib/preload-app.cjs'), sandbox: true, contextIsolation: true, nodeIntegration: false,
