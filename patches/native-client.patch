diff --git a/apps/desktop/src/preload-native-remote.ts b/apps/desktop/src/preload-native-remote.ts
new file mode 100644
index 0000000..7deed20
--- /dev/null
+++ b/apps/desktop/src/preload-native-remote.ts
@@ -0,0 +1,20 @@
+import { ipcRenderer } from 'electron'
+import { DESKTOP_IPC } from './ipc.ts'
+import type { NativeRemoteBridge, NativeRemoteEvent } from './native-remote-protocol.ts'
+/** No arbitrary IPC channel, Electron object, cookie, or native socket reaches the page. */
+export function createNativeRemoteBridge(): NativeRemoteBridge {
+  return {
+    connect: (address, token) => ipcRenderer.invoke(DESKTOP_IPC.nativeRemoteConnect, address, token),
+    release: lease => ipcRenderer.invoke(DESKTOP_IPC.nativeRemoteRelease, lease),
+    request: (lease, request) => ipcRenderer.invoke(DESKTOP_IPC.nativeRemoteRequest, lease, request),
+    cancel: (lease, id) => ipcRenderer.invoke(DESKTOP_IPC.nativeRemoteCancel, lease, id),
+    open: (lease, id) => ipcRenderer.invoke(DESKTOP_IPC.nativeRemoteOpen, lease, id),
+    send: (lease, id, data) => ipcRenderer.invoke(DESKTOP_IPC.nativeRemoteSend, lease, id, data),
+    close: (lease, id) => ipcRenderer.invoke(DESKTOP_IPC.nativeRemoteClose, lease, id),
+    subscribe(listener) {
+      const handle = (_event: Electron.IpcRendererEvent, event: NativeRemoteEvent): void => { listener(event) }
+      ipcRenderer.on(DESKTOP_IPC.nativeRemoteEvent, handle)
+      return () => { ipcRenderer.off(DESKTOP_IPC.nativeRemoteEvent, handle) }
+    },
+  }
+}
