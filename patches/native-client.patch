diff --git a/packages/api/remote-access/src/client/sources.ts b/packages/api/remote-access/src/client/sources.ts
new file mode 100644
index 0000000..dba4eb9
--- /dev/null
+++ b/packages/api/remote-access/src/client/sources.ts
@@ -0,0 +1,57 @@
+/** Resource access routing. A withdrawn source keeps its identity reservation and denies access. */
+import type { Context } from '@deepseek-ai/cordis'
+import type { HostObservable } from '@deepseek-ai/dsh-client-ui-slots'
+import type { TypertResourceKind } from '@deepseek-ai/dsh-typert-protocol'
+
+export interface RemoteAccessSource {
+  readonly key: string
+  owns(kind: TypertResourceKind, id: string): boolean
+  source(kind: TypertResourceKind, id: string, action: string): HostObservable<boolean>
+}
+const denied: HostObservable<boolean> = { getSnapshot: () => false, subscribe: () => () => {} }
+/** Stable outward sources switch subscriptions when a resource owner is registered or withdrawn. */
+export class ResourceAccessSources {
+  private readonly entries: { source: RemoteAccessSource; active: boolean }[] = []
+  private readonly listeners = new Set<() => void>()
+  private readonly cache = new Map<string, HostObservable<boolean>>()
+  constructor(private readonly local: RemoteAccessSource['source']) {}
+
+  source(kind: TypertResourceKind, id: string, action: string): HostObservable<boolean> {
+    const key = JSON.stringify([kind, id, action])
+    const cached = this.cache.get(key)
+    if (cached !== undefined) return cached
+    const current = (): HostObservable<boolean> => {
+      const owners = this.entries.filter(entry => entry.source.owns(kind, id))
+      if (owners.length > 1) throw new Error('Ambiguous resource access source')
+      const owner = owners[0]
+      return owner === undefined ? this.local(kind, id, action) : owner.active ? owner.source.source(kind, id, action) : denied
+    }
+    const observable: HostObservable<boolean> = {
+      getSnapshot: () => current().getSnapshot(),
+      subscribe: listener => {
+        let selected = current()
+        let unsubscribe = selected.subscribe(listener)
+        const rebind = (): void => {
+          const next = current()
+          if (next !== selected) { unsubscribe(); selected = next; unsubscribe = next.subscribe(listener) }
+          listener()
+        }
+        this.listeners.add(rebind)
+        return () => { this.listeners.delete(rebind); unsubscribe() }
+      },
+    }
+    this.cache.set(key, observable)
+    return observable
+  }
+
+  register(ctx: Context, source: RemoteAccessSource): () => void {
+    if (!source.key || this.entries.some(entry => entry.source.key === source.key)) throw new Error('Resource access source key already reserved')
+    const entry = { source, active: true }
+    this.entries.push(entry)
+    const notify = (): void => { for (const listener of [...this.listeners]) listener() }
+    const withdraw = (): void => { if (!entry.active) return; entry.active = false; notify() }
+    ctx.effect(() => withdraw, `remote-access.source.${source.key}`)
+    notify()
+    return withdraw
+  }
+}
