@@ -0,0 +1,153 @@
+/** Observable Workspace composition and retained source identity reservations. */
+import { notifySubscribers } from '@deepseek-ai/dsh-client-store'
+import type { Context } from '@deepseek-ai/cordis'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+import type { WorkspaceId } from '@deepseek-ai/dsh-workspace/types'
+import type { WorkspaceSnapshot } from './model.ts'
+import type { IWorkspaces, WorkspaceSource } from './service.ts'
+
+/** A source adapter owns mapped identities and translates them before remote dispatch. */
+export interface WorkspaceSourceRegistration {
+  readonly key: string
+  /** Must remain valid after withdrawal, reserving the source identity family. */
+  readonly ownsWorkspace: (id: WorkspaceId) => boolean
+  /** Must remain valid after withdrawal, reserving the source identity family. */
+  readonly ownsSession: (id: SessionId) => boolean
+  readonly workspaces: IWorkspaces
+}
+
+interface Registration {
+  readonly source: WorkspaceSourceRegistration
+  active: boolean
+  unsubscribe: () => void
+}
+
+/** Composes projected rows without moving authoritative state between Hosts. */
+export class WorkspaceSources implements WorkspaceSource {
+  private readonly records: Registration[] = []
+  private readonly listeners = new Set<() => void>()
+  private snapshot: WorkspaceSnapshot | undefined
+  private closed = false
+
+  /** @param ctx - Controller lifetime. @param local - Original local projection. */
+  constructor(ctx: Context, private readonly local: WorkspaceSource) {
+    const unsubscribe = local.subscribe(() => { this.invalidate() })
+    ctx.effect(() => () => {
+      this.closed = true
+      unsubscribe()
+      for (const record of this.records) {
+        record.active = false
+        record.unsubscribe()
+      }
+      this.listeners.clear()
+    }, 'workspace-controller.sources')
+  }
+
+  /** @returns identity-stable merged snapshot until a source invalidates. */
+  getSnapshot = (): WorkspaceSnapshot => {
+    if (this.snapshot !== undefined) return this.snapshot
+    const local = this.local.getSnapshot()
+    const sources = this.records.filter(record => record.active).map(record => {
+      const snapshot = record.source.workspaces.list.getSnapshot()
+      for (const row of snapshot.items) {
+        if (this.workspace(row.workspaceId) !== record.source.workspaces) throw new Error('Workspace source published a foreign identity')
+        for (const id of row.sessionIds) {
+          if (this.session(id) !== record.source.workspaces) throw new Error('Workspace source published a foreign Session identity')
+        }
+      }
+      for (const id of [...snapshot.archivedSessionIds, ...snapshot.pinnedSessionIds]) {
+        if (this.session(id) !== record.source.workspaces) throw new Error('Workspace source published a foreign Session identity')
+      }
+      return snapshot
+    })
+    for (const row of local.items) {
+      if (this.workspace(row.workspaceId) !== undefined) throw new Error('Local Workspace uses a reserved source identity')
+      for (const id of row.sessionIds) {
+        if (this.session(id) !== undefined) throw new Error('Local Session uses a reserved source identity')
+      }
+    }
+    for (const id of [...local.archivedSessionIds, ...local.pinnedSessionIds]) {
+      if (this.session(id) !== undefined) throw new Error('Local Session uses a reserved source identity')
+    }
+    this.snapshot = sources.length === 0 ? local : {
+      ...local,
+      items: [...local.items, ...sources.flatMap(source => source.items)],
+      archivedSessionIds: [...local.archivedSessionIds, ...sources.flatMap(source => source.archivedSessionIds)],
+      pinnedSessionIds: [...local.pinnedSessionIds, ...sources.flatMap(source => source.pinnedSessionIds)],
+    }
+    return this.snapshot
+  }
+
+  /** @param listener - Projection invalidation callback. @returns idempotent unsubscribe. */
+  subscribe = (listener: () => void): (() => void) => {
+    if (this.closed) throw new Error('Workspace sources disposed')
+    this.listeners.add(listener)
+    return () => { this.listeners.delete(listener) }
+  }
+
+  /**
+   * Register one source for the contributing fiber's lifetime. Retired keys cannot be reused.
+   * @param ctx - Contribution lifetime.
+   * @param source - Adapter exposing mapped rows and commands.
+   */
+  register(ctx: Context, source: WorkspaceSourceRegistration): void {
+    if (this.closed) throw new Error('Workspace sources disposed')
+    if (!source.key || this.records.some(record => record.source.key === source.key)) throw new Error('Workspace source key already reserved')
+    const record: Registration = { source, active: true, unsubscribe: () => {} }
+    this.records.push(record)
+    try {
+      this.snapshot = undefined
+      this.getSnapshot()
+      record.unsubscribe = source.workspaces.list.subscribe(() => {
+        if (!record.active) return
+        this.snapshot = undefined
+        try {
+          this.getSnapshot()
+        } catch (error) {
+          // Invalid source data withdraws this contribution, not the local catalog.
+          record.active = false
+          record.unsubscribe()
+          console.error('[workspace-controller.sources] source withdrawn after invalid catalog:', source.key, error)
+        }
+        this.invalidate()
+      })
+      ctx.effect(() => () => {
+        record.active = false
+        record.unsubscribe()
+        this.invalidate()
+      }, `workspace-controller.source.${source.key}`)
+    } catch (error) {
+      record.active = false
+      record.unsubscribe()
+      this.records.splice(this.records.indexOf(record), 1)
+      this.snapshot = undefined
+      throw error
+    }
+    this.invalidate()
+  }
+
+  /** @param id - UI Workspace identity. @returns source commands, or undefined for local. */
+  workspace(id: WorkspaceId): IWorkspaces | undefined {
+    return this.resolve(record => record.source.ownsWorkspace(id))
+  }
+
+  /** @param id - UI Session identity. @returns source commands, or undefined for local. */
+  session(id: SessionId): IWorkspaces | undefined {
+    return this.resolve(record => record.source.ownsSession(id))
+  }
+
+  private resolve(matches: (record: Registration) => boolean): IWorkspaces | undefined {
+    if (this.closed) throw new Error('Workspace sources disposed')
+    const owners = this.records.filter(matches)
+    if (owners.length > 1) throw new Error('Ambiguous Workspace source identity')
+    const owner = owners[0]
+    if (owner === undefined) return undefined
+    if (!owner.active) throw new Error('Workspace source is unavailable')
+    return owner.source.workspaces
+  }
+
+  private invalidate(): void {
+    this.snapshot = undefined
+    notifySubscribers(this.listeners, '[workspace-controller.sources]')
+  }
+}
