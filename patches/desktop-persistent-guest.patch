+/** Validate the IPC persistence opt-in; existing guests remain process-local.
+ * @param value - optional IPC options.
+ * @returns whether this guest owns persistent browser storage.
+ */
+export function persistentGuestOptions(value: unknown): boolean {
+  if (value === undefined) return false
+  if (typeof value !== 'object' || value === null || Array.isArray(value)
+    || Object.keys(value).length !== 1 || !('persistent' in value) || value.persistent !== true) {
+    throw new Error('desktop browser: invalid persistence options')
+  }
+  return true
+}
